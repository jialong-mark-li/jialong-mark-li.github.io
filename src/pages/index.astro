---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import educationLogos from "../assets/education-logos.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import EmpiricalLearningMatrix from "../components/EmpiricalLearningMatrix.astro";
import { cvUrl } from "../config/site";

const site = Astro.site ?? Astro.url;
const logoSprite = await getImage({ src: educationLogos, format: "webp", quality: 90 });

const affiliations = [
  {
    name: "Stanford University",
    detail: "Predoctoral Fellow",
    period: "2025 – Present",
    viewBox: "64 34 151 150",
  },
  {
    name: "Northwestern University",
    detail: "M.S. ML & DS",
    period: "2024",
    viewBox: "64 214 150 149",
  },
  {
    name: "UIUC",
    detail: "B.S. Statistics (CS Minor)",
    period: "2023",
    viewBox: "64 394 150 150",
  },
];

const publishedPosts = await getCollection("blog", ({ data }) => !data.draft);

const directory = [
  {
    title: "Research",
    href: "/research/",
    blurb: "Papers and ongoing research.",
    action: "View research",
  },
  {
    title: "Talks",
    href: "/talks/",
    blurb: "Research talks and reading-group slides.",
    action: "View talks",
  },
  ...(publishedPosts.length > 0
    ? [
        {
          title: "Blog",
          href: "/blog/",
          blurb: "Notes on research, methods, and ideas.",
          action: "Read blog",
        },
      ]
    : []),
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jialong (Mark) Li",
  alternateName: ["Jialong Li", "Mark Li"],
  url: new URL("/", site).href,
  image: new URL("/images/mark-headshot.svg", site).href,
  email: "mailto:markli@stanford.edu",
  jobTitle: "Predoctoral Research Fellow",
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: "Stanford Graduate School of Business",
    parentOrganization: { "@type": "CollegeOrUniversity", name: "Stanford University" },
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Northwestern University" },
    { "@type": "CollegeOrUniversity", name: "University of Illinois Urbana-Champaign" },
  ],
  knowsAbout: [
    "Quantitative Marketing",
    "Data Privacy",
    "Recommender Systems",
    "Generative AI",
    "Machine Learning",
  ],
  sameAs: [
    "https://github.com/jialong-mark-li",
    "https://www.linkedin.com/in/jialong-mark-li-b3b83a203/",
    "https://profiles.stanford.edu/jialong-li",
  ],
};
---

<BaseLayout title="Jialong (Mark) Li | Stanford GSB | Operations, Information & Technology (OIT)">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <main id="main-content" class="page shell home-page">
    <section aria-labelledby="page-title">
      <div class="hero">
        <img
          class="headshot"
          src="/images/mark-headshot.svg"
          alt="Jialong (Mark) Li"
          width="244"
          height="275"
        />

        <h1 class="hero-heading" id="page-title">Jialong (Mark) Li</h1>

        <div class="bio">
          <p>
            I am a second-year predoctoral fellow at the Stanford Graduate School of Business, working with Professors Samuel Goldberg, Yuyan Wang, and Haim Mendelson in Quantitative Marketing and Operations, Information &amp; Technology.
          </p>
          <p>
            My research combines machine learning, causal inference, and structural modeling to study online privacy and recommender systems. More broadly, my interests include human biases in decision-making, empirical industrial organization, and the development and auditing of generative AI systems.
          </p>
        </div>

        <ul class="intro-links" aria-label="Contact and academic links">
          <li><a class="pill" href="mailto:markli@stanford.edu">markli@stanford.edu</a></li>
          {cvUrl && <li><a class="pill" href={cvUrl}>CV</a></li>}
          <li><a class="pill" href={personSchema.sameAs[1]} target="_blank" rel="noopener noreferrer">LinkedIn <span class="external-arrow" aria-hidden="true">↑</span></a></li>
          <li><a class="pill" href={personSchema.sameAs[0]} target="_blank" rel="noopener noreferrer">GitHub <span class="external-arrow" aria-hidden="true">↑</span></a></li>
        </ul>
      </div>
    </section>

    <EmpiricalLearningMatrix />

    <section class="education" aria-labelledby="education-title">
      <h2 class="section-title" id="education-title">Education</h2>
      <ol class="affiliations">
        {
          affiliations.map((affiliation) => (
            <li>
              <svg
                class="institution-logo"
                viewBox={affiliation.viewBox}
                role="img"
                aria-label={`${affiliation.name} logo`}
              >
                <image href={logoSprite.src} width="264" height="644" />
              </svg>
              <div>
                <h3 class="entry-title">{affiliation.name}</h3>
                <p class="meta">{affiliation.detail} · <span class="tabular-nums">{affiliation.period}</span></p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <nav class="directory" aria-label="Explore the website" style={`--directory-columns: ${directory.length}`}>
      {
        directory.map((item) => (
          <a href={item.href}>
            <h2 class="entry-title">{item.title}</h2>
            <p>{item.blurb}</p>
            <span class="action-link">
              {item.action} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>

<style>
  .home-page {
    --text-display: 1.75rem;
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "photo heading" "photo bio" "photo links";
    grid-template-rows: auto auto 1fr;
    gap: var(--space-3) clamp(var(--space-5), 4vw, var(--space-7));
    align-items: start;
  }

  .headshot {
    grid-area: photo;
    width: clamp(8rem, 21vw, 15.25rem);
    aspect-ratio: 8 / 9;
    border: var(--border);
    border-radius: var(--radius-card);
    object-fit: cover;
  }

  .hero-heading {
    grid-area: heading;
    margin: 0;
  }

  .intro-links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .pill:hover {
    border-color: var(--color-link);
    background: var(--color-surface);
    color: var(--color-link-hover);
  }

  .bio {
    grid-area: bio;
  }

  .bio p {
    margin: 0;
  }

  .bio p + p {
    margin-top: var(--space-4);
  }

  .education {
    margin-block: var(--space-section);
  }

  .affiliations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-4) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--border);
    list-style: none;
  }

  .affiliations li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-5);
  }

  .affiliations li:first-child {
    padding-inline-start: 0;
  }

  .affiliations li:last-child {
    padding-inline-end: 0;
  }

  .affiliations li + li {
    border-inline-start: var(--border);
  }

  .institution-logo {
    display: block;
    flex: 0 0 auto;
    width: var(--space-7);
    height: var(--space-7);
  }

  .affiliations .entry-title {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-normal);
  }

  .affiliations .meta {
    margin-top: var(--space-1);
  }

  .directory {
    display: grid;
    grid-template-columns: repeat(var(--directory-columns), minmax(0, 1fr));
    gap: var(--space-5);
  }

  .directory > a {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-decoration: none;
  }

  .directory p {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .directory .action-link {
    margin-top: auto;
  }

  .directory > a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-background);
  }

  .directory > a:hover .action-link {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  @media (max-width: 47.5rem) {
    .hero {
      grid-template-areas: "photo heading" "bio bio" "links links";
      grid-template-rows: auto;
      column-gap: var(--space-4);
    }

    .headshot {
      width: clamp(6.5rem, 29vw, 8rem);
    }

    .hero-heading {
      align-self: center;
    }

    .affiliations li {
      flex-direction: column;
      align-items: flex-start;
      padding-inline: var(--space-3);
    }

    .institution-logo {
      width: var(--space-6);
      height: var(--space-6);
    }
  }

  @media (max-width: 35rem) {
    .intro-links {
      column-gap: var(--space-1);
    }

    .pill {
      padding-inline: var(--space-1);
    }

    .affiliations li {
      padding-inline: var(--space-2);
      overflow-wrap: anywhere;
    }

    .affiliations .entry-title {
      font-size: var(--text-small);
    }

    .directory {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
