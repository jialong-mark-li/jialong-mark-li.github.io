---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { status, period, title, summary, impact: contribution, abstract, links, authors, collaborators } = project.data;
const visibleLinks = project.data.kind === "paper" ? links.slice(0, 1) : links;
const selfName = "Jialong (Mark) Li";
---

<article class="entry" data-tone={project.data.tone} data-kind={project.data.kind}>
  <h3>{title}</h3>
  {(status || period) && (
    <p class="entry-meta tabular-nums">
      {status && <span class="status">{status}</span>}
      {status && period && <span aria-hidden="true">·</span>}
      {period && <span class="period">{period}</span>}
    </p>
  )}

  {authors.length > 0 && (
    <p class="credits meta">
      <strong>Authors</strong>
      {authors.map((author, index) => (
        <>
          {author === selfName ? <strong class="self">{author}</strong> : author}
          {index < authors.length - 1 && ", "}
        </>
      ))}
    </p>
  )}
  {collaborators.length > 0 && (
    <p class="credits meta">
      <strong>{collaborators.length > 1 ? "Advisors" : "Advisor"}</strong>
      {collaborators.join(", ")}
    </p>
  )}

  {contribution && <p class="summary"><strong>Contribution:</strong> {contribution}</p>}
  <p class="summary"><strong>My role:</strong> {summary}</p>

  {visibleLinks.length > 0 && (
    <ul class="links">
      {visibleLinks.map((link) => (
        <li>
          <a class="action-link" href={link.url} target="_blank" rel="noreferrer">
            {link.label} <span class="external-arrow" aria-hidden="true">↑</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {abstract && (
    <details class="abstract">
      <summary>Abstract</summary>
      <p>{abstract}</p>
    </details>
  )}
</article>

<style>
  .entry {
    padding: var(--space-6) 0;
    border-top: var(--border);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .status::before {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-muted);
    content: "";
  }

  .entry[data-tone="accepted"] .status::before {
    background: var(--color-research-accepted);
  }

  .entry[data-tone="review"] .status::before,
  .entry[data-kind="project"] .status::before {
    background: var(--color-link);
  }

  .period {
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .summary {
    margin: var(--space-3) 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .credits {
    margin-top: var(--space-2);
  }

  .credits > strong:first-child {
    margin-inline-end: var(--space-1);
  }

  .self {
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .abstract {
    margin-top: var(--space-4);
    font-size: var(--text-small);
  }

  .abstract summary {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .abstract summary:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .abstract p {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    white-space: pre-line;
  }
</style>
