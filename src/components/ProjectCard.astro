---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { status, period, title, summary, impact, abstract, links, authors, collaborators } = project.data;
const selfName = "Jialong (Mark) Li";
const visibleLinks = project.data.kind === "paper" ? links.slice(0, 1) : links;
---

<article class="entry-item">
  <h3 class="entry-title">{title}</h3>
  {(status || period) && (
    <p class="entry-status meta tabular-nums">
      {status && <span class="status">{status}</span>}
      {status && period && <span aria-hidden="true">·</span>}
      {period}
    </p>
  )}

  {authors.length > 0 && (
    <p class="credits meta">
      <strong>Authors</strong>
      {authors.map((author, index) => (
        <>
          {author === selfName ? <strong>{author}</strong> : author}
          {index < authors.length - 1 && ", "}
        </>
      ))}
    </p>
  )}
  {collaborators.length > 0 && (
    <p class="credits meta">
      <strong>{collaborators.length > 1 ? "Advisors" : "Advisor"}</strong>
      {collaborators.join(", ")}
    </p>
  )}

  {impact && <p class="description"><strong>Impact:</strong> {impact}</p>}
  <p class="description"><strong>My role:</strong> {summary}</p>

  {visibleLinks.length > 0 && (
    <div class="entry-links">
      {visibleLinks.map((link) => (
        <a class="action-link" href={link.url} target="_blank" rel="noopener noreferrer">
          {link.label} <span class="external-arrow" aria-hidden="true">↑</span>
        </a>
      ))}
    </div>
  )}

  {abstract && (
    <details class="abstract">
      <summary>Abstract</summary>
      <p>{abstract}</p>
    </details>
  )}
</article>

<style>
  .entry-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status::before {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-link);
    content: "";
  }

  .credits {
    margin-top: var(--space-2);
  }

  .credits > strong:first-child {
    margin-inline-end: var(--space-1);
  }

  .description {
    margin: var(--space-2) 0 0;
    font-size: var(--text-small);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-2);
  }

  .abstract {
    margin-top: var(--space-2);
    font-size: var(--text-small);
  }

  .abstract summary {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .abstract summary:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .abstract p {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    white-space: pre-line;
  }
</style>
