---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { status, venue, period, title, summary, impact: contribution, abstract, links, authors, collaborators } = project.data;
const visibleLinks = project.data.kind === "paper" ? links.slice(0, 1) : links;
const selfName = "Jialong Li";
---

<article class="entry" data-tone={project.data.tone} data-kind={project.data.kind}>
  <h3>{title}</h3>
  {authors.length > 0 && (
    <p class="authors meta">
      {authors.map((author, index) => (
        <>
          {author === selfName ? <strong class="self">{author}</strong> : author}
          {index < authors.length - 1 && ", "}
        </>
      ))}
    </p>
  )}
  {venue && <p class="venue meta tabular-nums">{venue}</p>}
  {(status || period || collaborators.length > 0) && (
    <p class="entry-meta meta tabular-nums">
      {status && <span class="status">{status}</span>}
      {period && <>{status && " · "}{period}</>}
      {collaborators.length > 0 && (
        <>
          {(status || period) && " · "}
          {collaborators.length > 1 ? "Advisors " : "Advisor "}
          {collaborators.join(", ")}
        </>
      )}
    </p>
  )}

  {contribution && <p class="summary"><strong>Contribution:</strong> {contribution}</p>}
  <p class="summary"><strong>My role:</strong> {summary}</p>

  {visibleLinks.length > 0 && (
    <ul class="links">
      {visibleLinks.map((link) => (
        <li>
          <a class="action-link" href={link.url} target="_blank" rel="noreferrer">
            {link.label} <span class="external-arrow" aria-hidden="true">↑</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {abstract && (
    <details class="abstract">
      <summary>Abstract</summary>
      <p>{abstract}</p>
    </details>
  )}
</article>

<style>
  .entry {
    padding: var(--space-6) 0;
    border-top: var(--border);
  }

  .entry-meta {
    margin-top: var(--space-2);
  }

  .status::before {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: var(--space-2);
    border-radius: 50%;
    vertical-align: 0.05em;
    background: var(--color-muted);
    content: "";
  }

  .entry[data-kind="project"] .status::before {
    background: var(--color-link);
  }

  h3 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .summary {
    margin: var(--space-3) 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .authors {
    margin-top: var(--space-2);
  }

  .venue {
    margin-top: var(--space-1);
    font-style: italic;
  }

  .self {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .abstract {
    margin-top: var(--space-4);
    font-size: var(--text-small);
  }

  .abstract summary {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .abstract summary:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .abstract p {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    white-space: pre-line;
  }
</style>
