---
const regimes = [
  {
    area: "foundation",
    title: "Foundation Models",
    example: "e.g., LLMs",
    information: "High",
    rules: "Complex, contextual language patterns",
    signals: "Rich text and training signals",
    solution: "Pretraining & scaling",
  },
  {
    area: "markets",
    title: "Human Digital Markets",
    example: "My research focus",
    information: "Low",
    rules: "Adaptive decisions & strategic responses",
    signals: "Policy-shaped data; missing counterfactuals",
    solution: "?",
  },
  {
    area: "games",
    title: "Closed Games",
    example: "e.g., AlphaGo Zero",
    information: "High",
    rules: "Fixed rules and explicit rewards",
    signals: "Repeatable self-play simulations",
    solution: "Simulation, search & RL",
  },
  {
    area: "physics",
    title: "Classical Physics",
    example: "e.g., Planetary Orbits",
    information: "Low",
    rules: "Stable governing laws",
    signals: "Limited real-world observations",
    solution: "Theory-driven modeling",
  },
];

const transfers = [
  {
    source: "Foundation Models → Digital Markets",
    description: "Use high-dimensional learning, language reasoning, and multimodal representations to incorporate richer information into empirical models.",
  },
  {
    source: "Classical Physics → Digital Markets",
    description: "Use theory-guided modeling to capture underlying economic and behavioral mechanisms, including preferences, beliefs, and incentives.",
  },
  {
    source: "Closed Games → Digital Markets",
    description: "Translate simulator-based exploration into field experiments and causal inference to identify responses to alternative policies.",
  },
];
---

<section class="learning-matrix shell" aria-labelledby="matrix-title">
  <header class="matrix-heading">
    <h2 id="matrix-title">The Limits of Scaling</h2>
    <p>An Empirical Learning Matrix</p>
  </header>

  <div class="matrix-grid" aria-label="Four regimes of empirical modeling by complexity of rules and effective information availability">
    <div class="information-axis">← Effective Information Availability</div>
    <div class="information-label high-information">
      <strong>High</strong>
      <span>Rich Signals &amp; Feedback</span>
    </div>
    <div class="information-label low-information">
      <strong>Low</strong>
      <span>Limited Signals &amp; Feedback</span>
    </div>

    <div class="rules-axis">
      <span class="rules-arrow" aria-hidden="true">↑</span>
      <span class="rules-axis-name">Complexity of Rules</span>
    </div>
    <div class="rules-label high-rules">
      <strong>High</strong>
      <span>Complex &amp; Adaptive</span>
    </div>
    <div class="rules-label low-rules">
      <strong>Low</strong>
      <span>Simple &amp; Stable</span>
    </div>

    {regimes.map((regime) => (
      <article class:list={["regime", regime.area]}>
        <header>
          <p class="mobile-information">{regime.information} Information</p>
          <h3>{regime.title}</h3>
          <p class="example">{regime.example}</p>
        </header>
        <h4>Condition</h4>
        <ul>
          <li>{regime.rules}</li>
          <li>{regime.signals}</li>
        </ul>
        <p class="solution"><strong>Solution:</strong> {regime.solution}</p>
      </article>
    ))}
  </div>

  <p class="matrix-explanation">
    Closed games in the lower-left corner offer an ideal setting for learning: known rules and rich, repeatable feedback. Foundation models draw strength from abundant data; classical physics from known laws. Human digital markets often have neither, with adaptive behavior and policy-shaped observations. This motivates drawing on three established approaches:
  </p>

  <div class="method-transfers" aria-label="Ideas from established approaches applied to digital markets">
    {transfers.map((transfer) => (
      <article class="transfer">
        <h3>{transfer.source}</h3>
        <p>{transfer.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .learning-matrix {
    padding-bottom: var(--space-section);
  }

  .matrix-heading {
    padding-top: var(--space-5);
    border-top: 2px solid var(--palette-box-border);
    margin-bottom: var(--space-5);
  }

  .matrix-heading h2 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .matrix-heading p {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: var(--space-6) minmax(0, 0.32fr) repeat(2, minmax(0, 1fr));
    grid-template-areas:
      ". . axis axis"
      ". . infohigh infolow"
      "rules high foundation markets"
      "rules low games physics";
    column-gap: 0;
    row-gap: 0;
  }

  .information-axis {
    grid-area: axis;
    text-align: center;
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .information-label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    text-align: center;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    padding-bottom: var(--space-3);
  }

  .information-label strong,
  .rules-label strong {
    font-weight: var(--weight-semibold);
  }

  .information-label span,
  .rules-label span {
    color: var(--color-muted);
  }

  .high-information { grid-area: infohigh; }
  .low-information { grid-area: infolow; }

  .rules-axis {
    grid-area: rules;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    align-self: center;
    justify-self: center;
    white-space: nowrap;
    font-weight: var(--weight-semibold);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .rules-axis-name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .rules-label {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-1);
    text-align: right;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    padding-right: var(--space-3);
  }

  .high-rules { grid-area: high; }
  .low-rules { grid-area: low; }

  .foundation { grid-area: foundation; }
  .markets { grid-area: markets; }
  .games { grid-area: games; }
  .physics { grid-area: physics; }

  .regime {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--palette-box-border);
    color: var(--color-text);
  }

  .regime.foundation,
  .regime.markets {
    border-bottom: 0;
  }

  .regime.foundation,
  .regime.games {
    border-right: 0;
  }

  .regime.markets {
    background: var(--palette-privacy-control);
    background: color-mix(in srgb, var(--palette-privacy-control) 45%, var(--color-background));
  }

  .regime h3 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .regime .example {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .mobile-information {
    display: none;
  }

  .regime h4 {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime ul {
    margin: var(--space-2) 0 var(--space-4);
    padding-left: var(--space-5);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime li + li {
    margin-top: var(--space-2);
  }

  .regime .solution {
    margin: auto 0 0;
    border-top: 1px solid var(--palette-reference);
    padding-top: var(--space-3);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime .solution strong {
    font-weight: var(--weight-semibold);
  }

  .matrix-explanation {
    max-width: var(--width-reading);
    margin: var(--space-6) 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .method-transfers {
    margin-top: var(--space-5);
    border-top: 2px solid var(--palette-box-border);
  }

  .transfer {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr);
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: var(--border);
  }

  .transfer h3 {
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .transfer p {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }

  @media (max-width: 860px) {
    .matrix-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "axis axis"
        "infohigh infolow"
        "rules rules"
        "high high"
        "foundation markets"
        "low low"
        "games physics";
      column-gap: 0;
      row-gap: var(--space-2);
    }

    .rules-axis {
      flex-direction: row-reverse;
      justify-self: start;
      margin-top: var(--space-3);
    }

    .rules-axis-name {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .rules-label {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      text-align: left;
      gap: var(--space-2);
    }

    .regime {
      padding: var(--space-4);
    }

    .regime.foundation,
    .regime.games {
      border-right: 1px solid var(--palette-box-border);
    }

    .regime.foundation,
    .regime.markets {
      border-bottom: 1px solid var(--palette-box-border);
    }
  }

  @media (max-width: 620px) {
    .matrix-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "rules"
        "high"
        "axis"
        "foundation"
        "markets"
        "low"
        "games"
        "physics";
      row-gap: var(--space-2);
    }

    .information-label {
      display: none;
    }

    .information-axis {
      margin-top: var(--space-2);
      text-align: left;
    }

    .mobile-information {
      display: block;
      margin: 0 0 var(--space-2);
      font-size: var(--text-small);
      color: var(--color-muted);
      line-height: var(--leading-snug);
    }

    .transfer {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
