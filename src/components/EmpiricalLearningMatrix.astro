---
const regimes = [
  {
    area: "foundation",
    title: "Foundation Models",
    example: "e.g., LLMs",
    information: "High",
    rules: "Complex, context-dependent patterns",
    data: "Massive, cross-domain text corpora",
    feedback: "Dense self-supervised training signals",
    solution: "Large-scale pretraining & representation learning",
  },
  {
    area: "markets",
    title: "Human Digital Markets",
    example: "My Research Focus",
    information: "Low",
    rules: "Heterogeneous decisions & strategic adaptation",
    data: "Sparse, policy-shaped behavioral signals",
    feedback: "Hidden preferences & missing counterfactuals",
    solution: "?",
  },
  {
    area: "games",
    title: "Closed Games",
    example: "e.g., AlphaGo Zero",
    information: "High",
    rules: "Fixed, fully specified game rules",
    data: "Scalable self-play simulations",
    feedback: "Explicit rewards & repeatable trials",
    solution: "Simulation, search & reinforcement learning",
  },
  {
    area: "physics",
    title: "Classical Physics",
    example: "e.g., Planetary Orbits",
    information: "Low",
    rules: "Stable, known governing laws",
    data: "Limited real-world measurements",
    feedback: "Real-world trajectories cannot be freely reset",
    solution: "Theory-driven modeling & parameter estimation",
  },
];
---

<section class="learning-matrix shell" aria-labelledby="matrix-title">
  <header class="matrix-heading">
    <h2 id="matrix-title">The Limits of Scaling</h2>
    <p>An Empirical Learning Matrix</p>
  </header>

  <div class="matrix-grid" aria-label="Four empirical modeling regimes by rule complexity and effective information availability">
    <div class="information-axis">
      <span class="desktop-axis">← Effective Information Availability</span>
      <span class="mobile-axis">Effective Information Availability: High to Low</span>
    </div>
    <div class="information-label high-information">
      <strong>High</strong>
      <span>Rich Signals &amp; Clear Feedback</span>
    </div>
    <div class="information-label low-information">
      <strong>Low</strong>
      <span>Partial Signals &amp; Limited Feedback</span>
    </div>
    <div class="rules-axis">Complexity of Rules ↑</div>
    <div class="rules-label high-rules">
      <strong>High</strong>
      <span>Complex &amp; Adaptive</span>
    </div>
    <div class="rules-label low-rules">
      <strong>Low</strong>
      <span>Simple &amp; Stable</span>
    </div>
    {regimes.map((regime) => (
      <article class:list={["regime", regime.area]}>
        <header>
          <p class="mobile-information">{regime.information} Information</p>
          <h3>{regime.title}</h3>
          <p class="example">{regime.example}</p>
        </header>
        <h4>Condition</h4>
        <ul>
          <li><strong>Rules:</strong> {regime.rules}</li>
          <li><strong>Data:</strong> {regime.data}</li>
          <li><strong>Feedback:</strong> {regime.feedback}</li>
        </ul>
        <p class="solution"><strong>Solution:</strong> {regime.solution}</p>
      </article>
    ))}
  </div>

  <p class="matrix-caption">
    I approach such questions by combining experiments and causal inference, machine learning, and economic modeling.
  </p>
</section>

<style>
  .learning-matrix {
    padding-bottom: var(--space-section);
  }

  .matrix-heading {
    margin-bottom: var(--space-6);
  }

  .matrix-heading h2 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .matrix-heading p {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: var(--space-6) minmax(0, 0.4fr) repeat(2, minmax(0, 1fr));
    grid-template-areas:
      ". . axis axis"
      ". . infohigh infolow"
      "rules high foundation markets"
      "rules low games physics";
    column-gap: var(--space-3);
    row-gap: var(--space-3);
  }

  .information-axis {
    grid-area: axis;
    text-align: center;
    font-weight: var(--weight-semibold);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .mobile-axis,
  .mobile-information {
    display: none;
  }

  .information-label {
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: var(--space-1);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .information-label strong {
    font-weight: var(--weight-semibold);
  }

  .information-label span {
    color: var(--color-muted);
  }

  .high-information { grid-area: infohigh; }
  .low-information { grid-area: infolow; }

  .rules-axis {
    grid-area: rules;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    align-self: center;
    justify-self: center;
    font-weight: var(--weight-semibold);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  .rules-label {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    text-align: right;
    gap: var(--space-1);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .rules-label strong {
    font-weight: var(--weight-semibold);
  }

  .rules-label span {
    color: var(--color-muted);
  }

  .high-rules { grid-area: high; }
  .low-rules { grid-area: low; }

  .foundation { grid-area: foundation; }
  .markets { grid-area: markets; }
  .games { grid-area: games; }
  .physics { grid-area: physics; }

  .regime {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius);
  }

  .regime h3 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .regime .example {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime h4 {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime ul {
    margin: var(--space-2) 0 var(--space-4);
    padding-left: var(--space-5);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .regime li + li {
    margin-top: var(--space-2);
  }

  .regime li strong,
  .solution strong {
    font-weight: var(--weight-semibold);
  }

  .regime .solution {
    margin: auto 0 0;
    padding-top: var(--space-3);
    border-top: var(--border);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .matrix-caption {
    max-width: var(--width-reading);
    margin: var(--space-5) 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .matrix-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "axis axis"
        "infohigh infolow"
        "rules rules"
        "high high"
        "foundation markets"
        "low low"
        "games physics";
    }

    .rules-axis {
      writing-mode: horizontal-tb;
      transform: none;
      justify-self: start;
      margin-top: var(--space-3);
    }

    .rules-label {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
    }

    .rules-label strong::after {
      content: " ·";
    }
  }

  @media (max-width: 600px) {
    .matrix-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "rules"
        "high"
        "axis"
        "foundation"
        "markets"
        "low"
        "games"
        "physics";
      row-gap: var(--space-2);
    }

    .information-label,
    .desktop-axis {
      display: none;
    }

    .mobile-axis,
    .mobile-information {
      display: block;
    }

    .information-axis {
      margin-top: var(--space-2);
      text-align: left;
    }

    .rules-label {
      margin-top: var(--space-3);
    }

    .regime {
      padding: var(--space-4);
    }

    .mobile-information {
      margin: 0 0 var(--space-2);
      color: var(--color-muted);
      font-size: var(--text-small);
    }

    .matrix-caption {
      margin-top: var(--space-4);
    }
  }
</style>
