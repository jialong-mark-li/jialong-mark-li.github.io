---
const pathname = Astro.url.pathname;
const navItems = [
  { label: "Home", href: "/", active: pathname === "/" },
  { label: "Research", href: "/research/", active: pathname.startsWith("/research") },
  { label: "Talks", href: "/talks/", active: pathname.startsWith("/talks") },
  { label: "Blog", href: "/blog/", active: pathname.startsWith("/blog") },
];
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Jialong (Mark) Li, home">Jialong (Mark) Li</a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: var(--border);
    background: var(--color-header);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .wordmark {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-link);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (max-width: 460px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
      padding-block: var(--space-2);
    }
  }
</style>
